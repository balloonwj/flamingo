    <!-- DebugConsole 依赖的 jsoncpp:请求/响应体的敏感字段掩码与美化缩进 -->
    <!--
      jsoncpp 1.9.0 上游代码在 json_reader.cpp 里把 asUInt64() 的结果赋给
      size_t 类型的 stackLimit_，Win32 下 size_t 是 32 位，编译器报 C4244。
      按本仓库对第三方源码的既有做法（参见 flamingoclient/Source/Flamingo.vcxproj
      对 zlib 的 C4267 处理），在此对该文件单独抑制，不改第三方源码。
    -->
    <ClCompile Include="..\third-party\jsoncpp\json_reader.cpp">
      <DisableSpecificWarnings>4244;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
