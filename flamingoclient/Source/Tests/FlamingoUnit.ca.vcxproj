  <!-- 构建完成后把同配置的 FlamingoMedia.dll 复制到测试程序所在目录，供 MediaModuleLoaderTests 加载。
       DLL 的输出目录与 Flamingo.exe 相同：Debug|x64 在 Debug\，Release|x64 在 Release\，
       Win32 两个配置在 <配置>_Win32\。 -->
  <Target Name="CopyFlamingoMediaDll" AfterTargets="Build">
    <PropertyGroup>
      <FlamingoMediaDllDir Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">..\..\Debug\</FlamingoMediaDllDir>
      <FlamingoMediaDllDir Condition="'$(Configuration)|$(Platform)'=='Release|x64'">..\..\Release\</FlamingoMediaDllDir>
      <FlamingoMediaDllDir Condition="'$(Platform)'=='Win32'">..\..\$(Configuration)_Win32\</FlamingoMediaDllDir>
    </PropertyGroup>
    <Copy SourceFiles="$(FlamingoMediaDllDir)FlamingoMedia.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(FlamingoMediaDllDir)FlamingoMedia.dll')" />
  </Target>
  <!-- 构建完成后把同配置的 FlamingoFileShare.dll 复制到测试程序所在目录，供 FileShareModuleTests 加载。
       输出目录规则与 FlamingoMedia.dll 相同：Debug|x64 在 Debug\，Release|x64 在 Release\，
       Win32 两个配置在 <配置>_Win32\。 -->
  <Target Name="CopyFlamingoFileShareDll" AfterTargets="Build">
    <PropertyGroup>
      <FlamingoFileShareDllDir Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">..\..\Debug\</FlamingoFileShareDllDir>
