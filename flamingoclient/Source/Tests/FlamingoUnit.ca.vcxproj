  </Target>
  <!-- 构建完成后把同配置的 FlamingoP2P.dll 复制到测试程序所在目录，供 P2PModuleTests 加载。
       输出目录规则与 FlamingoMedia.dll 相同：Debug|x64 在 Debug\，Release|x64 在 Release\，
       Win32 两个配置在 <配置>_Win32\。 -->
  <Target Name="CopyFlamingoP2PDll" AfterTargets="Build">
    <PropertyGroup>
