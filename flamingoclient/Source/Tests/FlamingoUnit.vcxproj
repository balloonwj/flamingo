      <FlamingoFileShareDllDir Condition="'$(Configuration)|$(Platform)'=='Release|x64'">..\..\Release\</FlamingoFileShareDllDir>
      <FlamingoFileShareDllDir Condition="'$(Platform)'=='Win32'">..\..\$(Configuration)_Win32\</FlamingoFileShareDllDir>
