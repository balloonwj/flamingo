diff --git a/sherpa-onnx/csrc/memory-file-registry.cc b/sherpa-onnx/csrc/memory-file-registry.cc
new file mode 100644
index 0000000..57276e2
--- /dev/null
+++ b/sherpa-onnx/csrc/memory-file-registry.cc
@@ -0,0 +1,58 @@
+// sherpa-onnx/csrc/memory-file-registry.cc
+//
+// Flamingo patch, see memory-file-registry.h.
+
+#include "sherpa-onnx/csrc/memory-file-registry.h"
+
+#include <map>
+#include <mutex>  // NOLINT
+#include <utility>
+
+namespace sherpa_onnx {
+
+namespace {
+
+struct MemoryFile {
+  const void *data;
+  size_t size;
+};
+
+std::mutex &RegistryMutex() {
+  static std::mutex m;
+  return m;
+}
+
+std::map<std::string, MemoryFile> &Registry() {
+  static std::map<std::string, MemoryFile> r;
+  return r;
+}
+
+}  // namespace
+
+void RegisterMemoryFile(const std::string &name, const void *data,
+                        size_t size) {
+  std::lock_guard<std::mutex> lock(RegistryMutex());
+  MemoryFile f;
+  f.data = data;
+  f.size = size;
+  Registry()[name] = f;
+}
+
+void UnregisterMemoryFile(const std::string &name) {
+  std::lock_guard<std::mutex> lock(RegistryMutex());
+  Registry().erase(name);
+}
+
+bool LookupMemoryFile(const std::string &name, const void **data,
+                      size_t *size) {
+  std::lock_guard<std::mutex> lock(RegistryMutex());
+  auto it = Registry().find(name);
+  if (it == Registry().end()) {
+    return false;
+  }
+  *data = it->second.data;
+  *size = it->second.size;
+  return true;
+}
+
+}  // namespace sherpa_onnx
diff --git a/sherpa-onnx/csrc/memory-file-registry.h b/sherpa-onnx/csrc/memory-file-registry.h
new file mode 100644
index 0000000..2472980
--- /dev/null
+++ b/sherpa-onnx/csrc/memory-file-registry.h
@@ -0,0 +1,31 @@
+// sherpa-onnx/csrc/memory-file-registry.h
+//
+// Flamingo patch: lets a caller register a named block of memory that the
+// model loaders treat as a file. Used to load models stored as resources
+// inside a DLL without writing them to disk.
+
+#ifndef SHERPA_ONNX_CSRC_MEMORY_FILE_REGISTRY_H_
+#define SHERPA_ONNX_CSRC_MEMORY_FILE_REGISTRY_H_
+
+#include <cstddef>
+#include <string>
+
+namespace sherpa_onnx {
+
+// Registers `data` (of `size` bytes) under `name`. The memory is not copied
+// and must stay valid until UnregisterMemoryFile(name) is called and every
+// recognizer created from it has been destroyed. Registering an existing name
+// replaces the previous entry.
+void RegisterMemoryFile(const std::string &name, const void *data,
+                        size_t size);
+
+// Removes the entry registered under `name`, if any.
+void UnregisterMemoryFile(const std::string &name);
+
+// Returns true and fills `data` / `size` if `name` is registered.
+bool LookupMemoryFile(const std::string &name, const void **data,
+                      size_t *size);
+
+}  // namespace sherpa_onnx
+
+#endif  // SHERPA_ONNX_CSRC_MEMORY_FILE_REGISTRY_H_
